-# Backend Environment Variables Example
# Copy this to .env and update with your actual values

# API Keys
# Use either GROQ_API_KEY for Groq models or OPENAI_API_KEY for OpenAI/OpenRouter.
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# CORS Configuration
# For local development: * (allows all origins)
# For production: specify exact origins to restrict cross-origin requests
# Format: comma-separated list of URLs
# Example: https://your-frontend.vercel.app,https://api.yourdomain.com,http://localhost:3000
ALLOWED_ORIGINS=*

# Model Configuration
MODEL=groq/llama-3.1-8b-instant
# MODEL=openrouter/deepseek/deepseek-chat
OPENAI_BASE_URL=https://openrouter.ai/api/v1
